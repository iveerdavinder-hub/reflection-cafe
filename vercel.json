{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": ".",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "admin-(.*)"
        }
      ],
      "destination": "/admin.html"
    },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/admin/", "destination": "/admin.html" },
    { "source": "/soda", "destination": "/soda.html" },
    { "source": "/soda/", "destination": "/soda.html" },
    { "source": "/glacier", "destination": "/glacier/dist/index.html" },
    { "source": "/glacier/", "destination": "/glacier/dist/index.html" }
  ]
}
